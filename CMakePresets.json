{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "SLAYER3D_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "editor",
            "displayName": "Optimized Editor",
            "description": "Build the interactive editor with optimizations and without test or demo targets.",
            "inherits": "release",
            "binaryDir": "${sourceDir}/build/editor",
            "cacheVariables": {
                "SLAYER3D_BUILD_TESTS": "OFF",
                "SLAYER3D_BUILD_DEMOS": "OFF",
                "SLAYER3D_BUILD_BENCHMARKS": "OFF"
            }
        },
        {
            "name": "editor-profile",
            "displayName": "Instrumented Editor",
            "description": "Build the interactive editor with optimizations and profiler-friendly debug symbols.",
            "inherits": "editor",
            "binaryDir": "${sourceDir}/build/editor-profile",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "sanitizers",
            "displayName": "Sanitizers",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build/sanitizers",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SLAYER3D_ENABLE_SANITIZERS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "editor",
            "configurePreset": "editor",
            "targets": [
                "slayer3d_editor"
            ]
        },
        {
            "name": "editor-profile",
            "configurePreset": "editor-profile",
            "targets": [
                "slayer3d_editor"
            ]
        },
        {
            "name": "sanitizers",
            "configurePreset": "sanitizers"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "release",
            "configurePreset": "release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "sanitizers",
            "configurePreset": "sanitizers",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
