{
  "schema": "slayer3d.scene.v0",
  "name": "scene.play",
  "input": {
    "actions": [
      "action.move.forward",
      "action.move.back",
      "action.move.left",
      "action.move.right",
      "action.jump",
      "action.interact",
      "action.fire",
      "action.pause"
    ],
    "mouse_capture": true
  },
  "ui": {
    "text": [
      {
        "name": "ui.reticle",
        "text": "+",
        "font": "font.hud",
        "position": [0.5, 0.5],
        "anchor": "center",
        "color": [255, 255, 255, 210],
        "scale": 1.0
      },
      {
        "name": "ui.fps",
        "text": "FPS {fps}",
        "font": "font.hud",
        "position": [0.02, 0.03],
        "anchor": "top_left",
        "color": [190, 230, 255, 210],
        "scale": 0.75
      }
    ]
  }
}
