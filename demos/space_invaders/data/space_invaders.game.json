          { "type": "pulse", "rate": 5.0, "color": [0.70, 0.95, 1.0], "color_blend": 0.20, "intensity_add": 1.1, "range_add": 0.45 }
        ]
      },
      {
        "name": "light.player_two_core",
        "type": "point",
        "target_entity": "entity.player2",
        "offset": [0.0, 0.0, 0.75],
        "color": [1.0, 0.72, 0.25],
        "intensity": 6.4,
        "range": 3.2,
        "effects": [
          { "type": "pulse", "rate": 4.2, "color": [1.0, 0.90, 0.42], "color_blend": 0.24, "intensity_add": 0.9, "range_add": 0.35 }
        ]
      },
      {
        "name": "light.shield_floor",
        "type": "point",
        "position": [0.0, -2.55, 0.55],
        "color": [0.22, 1.0, 0.62],
        "intensity": 5.0,
        "range": 5.8,
        "effects": [
          { "type": "pulse", "rate": 1.7, "color": [0.70, 1.0, 0.80], "color_blend": 0.25, "intensity_add": 0.65, "range_add": 0.45 }
        ]
      }
    ]
  }
}
