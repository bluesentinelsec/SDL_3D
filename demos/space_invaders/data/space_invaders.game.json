          { "type": "color_cycle", "duration": 5.4, "phase": 0.18, "colors": [[0.30, 1.0, 0.28], [0.12, 1.0, 0.78], [0.90, 1.0, 0.20]], "color_blend": 1.0 }
        ]
      },
      {
