{
  "schema": "slayer3d.game.v0",
  "imports": [
    { "path": "fragments/assets.json", "sections": ["assets"] },
    { "path": "fragments/scripts.json", "sections": ["scripts", "adapters"] },
    { "path": "fragments/input.json", "sections": ["input"] },
    { "path": "fragments/runtime.json", "sections": ["render", "update_phases", "presentation", "transitions"] },
    { "path": "fragments/actors.json", "sections": ["entities", "actor_archetypes", "actor_pools"] },
    { "path": "fragments/logic.json", "sections": ["signals", "logic"] }
  ],
  "metadata": {
    "name": "Space Invaders",
    "id": "demo.space_invaders",
    "version": "0.1.0",
    "description": "Data-authored fixed-screen arcade shooter using 3D geometry, pooled actors, Lua gameplay rules, dynamic lighting, and particles."
  },
  "app": {
    "title": "Slayer 3D Space Invaders",
    "logical_width": 1280,
    "logical_height": 720,
    "backend": "opengl",
    "window": {
      "display_mode": "windowed",
      "development_display_mode": "windowed",
      "production_display_mode": "windowed",
      "maximized": true,
      "resizable": true,
      "vsync": true,
      "renderer": "opengl"
    },
    "tick_rate": 0.008333333,
    "max_ticks_per_frame": 12,
    "enable_audio": false,
    "pause": {
      "action": "action.pause",
      "allowed_if": {
        "type": "property.compare",
        "target": "entity.game",
        "key": "game_over",
        "op": "==",
        "value": false
      }
    },
    "quit": {
      "action": "action.exit",
      "transition": "quit",
      "quit_signal": "signal.app.quit_fade_done"
    },
    "scene_shortcuts": [
      { "action": "action.scene.title", "scene": "scene.title" },
      { "action": "action.scene.play", "scene": "scene.play" }
    ],
    "input_policy": {
      "global_actions": [
        "action.exit",
        "action.scene.title",
        "action.scene.play"
      ]
    },
    "scene_transition_policy": {
      "allow_same_scene": false,
      "allow_interrupt": false,
      "reset_menu_input_on_request": true
    }
  },
  "scenes": {
    "initial": "scene.splash",
    "files": [
      "scenes/splash.scene.json",
      "scenes/title.scene.json",
      "scenes/multiplayer.scene.json",
      "scenes/multiplayer_lan.scene.json",
      "scenes/options.scene.json",
      "scenes/play.scene.json"
    ]
  },
  "world": {
    "name": "world.space_invaders",
    "kind": "fixed_screen",
    "units": "world_units",
    "axes": {
      "horizontal": "x",
      "vertical": "y",
      "depth": "z"
    },
    "bounds": {
      "min": [-8.6, -5.0, -1.2],
      "max": [8.6, 5.1, 3.5]
    },
    "ambient_light": [0.006, 0.008, 0.018],
    "cameras": [
      {
        "name": "camera.arcade",
        "type": "orthographic",
        "position": [0.0, 0.0, 17.0],
        "target": [0.0, 0.0, 0.0],
        "up": [0.0, 1.0, 0.0],
        "size": 10.8,
        "active": true
      },
      {
        "name": "camera.dramatic",
        "type": "perspective",
        "position": [0.0, -7.7, 6.2],
        "target": [0.0, 0.1, 0.0],
        "up": [0.0, 0.0, 1.0],
        "fovy": 51.0,
        "active": false
      }
    ],
    "lights": [
      {
        "name": "light.left_neon",
        "type": "spot",
        "position": [-6.4, -0.2, 3.2],
        "direction": [0.18, 0.0, -1.0],
        "color": [1.0, 0.08, 0.18],
        "intensity": 13.5,
        "range": 8.0,
        "inner_cutoff": 0.80,
        "outer_cutoff": 0.38,
        "effects": [
          { "type": "color_cycle", "duration": 6.5, "phase": 0.05, "colors": [[1.0, 0.05, 0.16], [1.0, 0.20, 0.46], [1.0, 0.48, 0.10]], "color_blend": 1.0 },
          { "type": "pulse", "rate": 2.8, "color": [1.0, 0.45, 0.32], "color_blend": 0.16, "intensity_add": 1.2, "range_add": 0.7 }
        ]
      },
      {
        "name": "light.right_neon",
        "type": "spot",
        "position": [6.4, -0.2, 3.2],
        "direction": [-0.18, 0.0, -1.0],
        "color": [0.08, 0.34, 1.0],
        "intensity": 13.5,
        "range": 8.0,
        "inner_cutoff": 0.80,
        "outer_cutoff": 0.38,
        "effects": [
          { "type": "color_cycle", "duration": 7.1, "phase": 0.32, "colors": [[0.06, 0.28, 1.0], [0.10, 0.85, 1.0], [0.36, 0.12, 1.0]], "color_blend": 1.0 },
          { "type": "pulse", "rate": 2.35, "color": [0.38, 0.92, 1.0], "color_blend": 0.18, "intensity_add": 1.0, "range_add": 0.8 }
        ]
