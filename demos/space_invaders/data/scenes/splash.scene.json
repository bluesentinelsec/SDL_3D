{
  "schema": "sdl3d.scene.v0",
  "name": "scene.splash",
  "updates_game": true,
  "renders_world": true,
  "camera": "camera.arcade",
  "entities": [
    "entity.field.base",
    "entity.effect.stars",
    "entity.effect.nebula",
    "entity.presentation"
  ],
  "input": {
    "actions": [
      "action.menu.select"
    ]
  },
  "transitions": {
    "enter": "scene_in",
    "exit": "scene_out"
  },
  "activity": {
    "enabled": true,
    "input": "any",
    "consume_wake_input": true,
    "on_enter": [
      { "type": "timer.start", "timer": "timer.splash.done" }
    ],
    "on_active": [
      { "type": "scene.set", "scene": "scene.title" }
    ]
  },
  "ui": {
    "text": [
      {
        "name": "ui.splash.title",
        "font": "font.title",
        "text": "SDL3D",
        "x": 0.5,
        "y": 0.40,
        "normalized": true,
        "centered": true,
        "color": [220, 245, 255, 255]
      },
      {
        "name": "ui.splash.subtitle",
        "font": "font.small",
        "text": "SPACE INVADERS DATA DEMO",
        "x": 0.5,
        "y": 0.55,
        "normalized": true,
        "centered": true,
        "color": [120, 230, 255, 230]
      }
    ]
  }
}
