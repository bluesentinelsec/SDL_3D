{
  "schema": "slayer3d.scene.v0",
  "name": "scene.title",
  "updates_game": true,
  "renders_world": true,
  "camera": "camera.arcade",
  "entities": [
    "entity.field.base",
    "entity.field.bottom_glow",
    "entity.field.top_glow",
    "entity.effect.stars",
    "entity.effect.nebula",
    "entity.player",
    "entity.presentation"
  ],
  "input": {
    "actions": [
      "action.menu.up",
      "action.menu.down",
      "action.menu.select"
    ]
  },
  "transitions": {
    "enter": "scene_in",
    "exit": "scene_out"
  },
  "menus": [
    {
      "name": "menu.title",
      "up_action": "action.menu.up",
      "down_action": "action.menu.down",
      "select_action": "action.menu.select",
      "move_signal": "signal.ui.menu.move",
      "select_signal": "signal.ui.menu.select",
      "selected": 0,
      "items": [
        {
          "label": "Single Player",
          "scene": "scene.play",
          "scene_state": { "key": "match_mode", "value": "single" }
        },
        {
          "label": "Multiplayer",
          "scene": "scene.multiplayer"
        },
        {
          "label": "Options",
          "scene": "scene.options"
        },
        {
          "label": "Exit",
          "quit": true
        }
      ]
    }
  ],
  "ui": {
    "text": [
      {
        "name": "ui.title.logo",
        "font": "font.title",
        "text": "SPACE INVADERS",
        "x": 0.5,
        "y": 0.22,
        "normalized": true,
        "centered": true,
        "color": [230, 248, 255, 255]
      },
      {
        "name": "ui.title.tagline",
        "font": "font.small",
        "text": "3D GEOMETRY  /  BLOOM  /  POOLS  /  LUA RULES",
        "x": 0.5,
        "y": 0.33,
        "normalized": true,
        "centered": true,
        "color": [124, 255, 190, 230]
      }
    ],
    "menus": [
      {
        "name": "ui.title.menu",
        "menu": "menu.title",
        "font": "font.hud",
        "x": 0.41,
        "y": 0.48,
        "gap": 0.075,
        "normalized": true,
        "align": "left",
        "color": [220, 236, 255, 245],
        "selected_color": [255, 238, 125, 255],
        "selected_pulse_alpha": true,
        "cursor": {
          "text": ">",
          "offset_x": -0.035,
          "align": "right",
          "color": [255, 82, 190, 255],
          "pulse_alpha": true
        }
      }
    ]
  }
}
