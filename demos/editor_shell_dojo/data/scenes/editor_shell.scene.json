{
  "schema": "slayer3d.scene.v0",
  "name": "scene.editor_shell.dojo",
  "camera": "camera.editor_shell.viewport",
  "updates_game": true,
  "renders_world": true,
  "on_enter_signal": "signal.editor.scene.enter",
  "input": {
    "mouse_capture": "unpaused",
    "mouse_capture_if": { "type": "scene_state.compare", "key": "editor.view.mode", "op": "==", "value": "flyby_3d" },
    "actions": [
      "action.exit",
      "action.editor.tool.cycle",
      "action.editor.selection.clear",
      "action.editor.selection.inspect",
      "action.editor.command.commit",
      "action.editor.command.undo",
      "action.editor.command.redo",
      "action.editor.delete_selected",
      "action.editor.export",
      "action.editor.test_run.prepare",
      "action.editor.test_run.enter",
      "action.editor.view.toggle",
      "action.editor.view.quad",
      "action.editor.view.perspective",
      "action.editor.view.top",
      "action.editor.view.front",
      "action.editor.view.side",
      "action.editor.ortho.pan.left",
      "action.editor.ortho.pan.right",
      "action.editor.ortho.pan.up",
      "action.editor.ortho.pan.down",
      "action.editor.ortho.zoom.in",
      "action.editor.ortho.zoom.out",
      "action.editor.ortho.zoom.wheel",
      "action.editor.grid.decrease",
      "action.editor.grid.increase",
      "action.editor.wall_axis.toggle",
      "action.editor.mode.select",
      "action.editor.brush.lower_y",
      "action.editor.brush.raise_y",
      "action.editor.palette.brush",
      "action.editor.palette.material",
      "action.editor.palette.game_object",
      "action.editor.palette.close",
      "action.editor.palette.previous",
      "action.editor.palette.next",
      "action.editor.palette.accept",
      "action.editor.camera.forward",
      "action.editor.camera.back",
      "action.editor.camera.left",
      "action.editor.camera.right",
      "action.editor.camera.up",
      "action.editor.camera.down",
      "action.editor.camera.look",
      "action.editor.camera.fast"
    ]
  },
  "entities": ["entity.editor_shell.camera"],
  "world": {
    "skybox": {
      "pos_x": "image.editor_shell.skybox.px",
      "neg_x": "image.editor_shell.skybox.nx",
      "pos_y": "image.editor_shell.skybox.py",
      "neg_y": "image.editor_shell.skybox.ny",
      "pos_z": "image.editor_shell.skybox.pz",
      "neg_z": "image.editor_shell.skybox.nz",
      "size": 400.0
    },
    "brush_worlds": [
      { "world": "brush.editor_shell.target", "position": [0.0, 0.0, 0.0] }
    ]
  },
  "world_viewports": [
    {
      "name": "editor.perspective",
      "camera": "camera.editor_shell.viewport",
      "rect": [0, 0, 640, 360],
      "active_if": { "type": "scene_state.compare", "key": "editor.view.mode", "op": "==", "value": "quad_view", "default": "quad_view" }
    },
    {
      "name": "editor.top_xy",
      "camera": "camera.editor_shell.ortho_top",
      "rect": [640, 0, 640, 360],
      "active_if": { "type": "scene_state.compare", "key": "editor.view.mode", "op": "==", "value": "quad_view", "default": "quad_view" }
    },
    {
      "name": "editor.front_xz",
      "camera": "camera.editor_shell.ortho_front",
      "rect": [0, 360, 640, 360],
      "active_if": { "type": "scene_state.compare", "key": "editor.view.mode", "op": "==", "value": "quad_view", "default": "quad_view" }
    },
    {
      "name": "editor.side_yz",
      "camera": "camera.editor_shell.ortho_side",
      "rect": [640, 360, 640, 360],
      "active_if": { "type": "scene_state.compare", "key": "editor.view.mode", "op": "==", "value": "quad_view", "default": "quad_view" }
    }
  ],
  "editor": {
    "selection": {
      "mode": "click",
      "select_button": "LEFT",
      "secondary_select_button": "RIGHT",
      "clear_on_miss": true,
      "trace": {
        "source": "camera_screen",
        "viewport": [1280.0, 720.0],
        "viewports": [
          {
            "camera": "camera.editor_shell.viewport",
            "rect": [0, 0, 640, 360],
            "active_if": { "type": "scene_state.compare", "key": "editor.view.mode", "op": "==", "value": "quad_view", "default": "quad_view" },
            "work_plane": {
              "enabled": true,
              "normal": [0.0, 1.0, 0.0],
              "distance": 0.0,
              "distance_key": "editor.work_plane.distance"
            }
          },
          {
            "camera": "camera.editor_shell.viewport",
            "rect": [0, 0, 1280, 720],
            "screen": "center",
            "active_if": { "type": "scene_state.compare", "key": "editor.view.mode", "op": "==", "value": "flyby_3d" },
            "work_plane": {
              "enabled": true,
              "normal": [0.0, 1.0, 0.0],
              "distance": 0.0,
              "distance_key": "editor.work_plane.distance"
            }
          },
          {
            "camera": "camera.editor_shell.ortho_top",
            "rect": [640, 0, 640, 360],
            "active_if": { "type": "scene_state.compare", "key": "editor.view.mode", "op": "==", "value": "quad_view", "default": "quad_view" },
            "work_plane": {
              "enabled": true,
              "normal": [0.0, 1.0, 0.0],
              "distance": 0.0,
              "distance_key": "editor.work_plane.distance"
            }
          },
          {
            "camera": "camera.editor_shell.ortho_front",
            "rect": [0, 360, 640, 360],
            "active_if": { "type": "scene_state.compare", "key": "editor.view.mode", "op": "==", "value": "quad_view", "default": "quad_view" },
            "work_plane": {
              "enabled": true,
              "normal": [0.0, 0.0, 1.0],
              "distance": 0.0,
              "distance_key": "editor.work_plane.distance"
            }
          },
          {
            "camera": "camera.editor_shell.ortho_side",
            "rect": [640, 360, 640, 360],
            "active_if": { "type": "scene_state.compare", "key": "editor.view.mode", "op": "==", "value": "quad_view", "default": "quad_view" },
            "work_plane": {
              "enabled": true,
              "normal": [1.0, 0.0, 0.0],
              "distance": 0.0,
              "distance_key": "editor.work_plane.distance"
            }
          },
          {
            "camera": "camera.editor_shell.ortho_top",
            "rect": [0, 0, 1280, 720],
            "active_if": { "type": "scene_state.compare", "key": "editor.view.mode", "op": "==", "value": "orthographic_top" },
            "work_plane": {
              "enabled": true,
              "normal": [0.0, 1.0, 0.0],
              "distance": 0.0,
              "distance_key": "editor.work_plane.distance"
            }
          },
          {
            "camera": "camera.editor_shell.ortho_front",
            "rect": [0, 0, 1280, 720],
            "active_if": { "type": "scene_state.compare", "key": "editor.view.mode", "op": "==", "value": "orthographic_front" },
            "work_plane": {
              "enabled": true,
              "normal": [0.0, 0.0, 1.0],
              "distance": 0.0,
              "distance_key": "editor.work_plane.distance"
            }
          },
          {
            "camera": "camera.editor_shell.ortho_side",
            "rect": [0, 0, 1280, 720],
            "active_if": { "type": "scene_state.compare", "key": "editor.view.mode", "op": "==", "value": "orthographic_side" },
            "work_plane": {
              "enabled": true,
              "normal": [1.0, 0.0, 0.0],
              "distance": 0.0,
              "distance_key": "editor.work_plane.distance"
            }
          }
        ],
        "near": 0.05,
        "far": 100.0,
        "model_filter": "brush_worlds",
        "contents_mask": "solid",
        "work_plane": {
          "enabled": true,
          "normal": [0.0, 1.0, 0.0],
          "normal_key": "editor.work_plane.normal",
          "distance": 0.0,
          "distance_key": "editor.work_plane.distance"
        }
      },
      "outputs": {
        "hit_key": "editor.selection.hit",
        "type_key": "editor.selection.type",
        "world_key": "editor.selection.world",
        "element_key": "editor.selection.element",
        "material_key": "editor.selection.material",
        "world_stable_id_key": "editor.selection.world_stable_id",
        "element_stable_id_key": "editor.selection.element_stable_id",
        "material_stable_id_key": "editor.selection.material_stable_id",
        "face_stable_id_key": "editor.selection.face_stable_id",
        "face_rendered_key": "editor.selection.face_rendered",
        "compiled_face_index_key": "editor.selection.compiled_face_index",
        "compiled_mesh_index_key": "editor.selection.compiled_mesh_index",
        "compiled_first_vertex_key": "editor.selection.compiled_first_vertex",
        "compiled_vertex_count_key": "editor.selection.compiled_vertex_count",
        "compiled_triangle_count_key": "editor.selection.compiled_triangle_count",
        "element_index_key": "editor.selection.element_index",
        "face_index_key": "editor.selection.face_index",
        "fraction_key": "editor.selection.fraction",
        "point_key": "editor.selection.point",
        "normal_key": "editor.selection.normal"
      },
      "hover_outputs": {
        "hit_key": "editor.hover.hit",
        "element_key": "editor.hover.element",
        "face_stable_id_key": "editor.hover.face_stable_id",
        "face_rendered_key": "editor.hover.face_rendered",
        "compiled_face_index_key": "editor.hover.compiled_face_index"
      },
      "on_select": "signal.editor.pointer.primary",
      "on_secondary_select": "signal.editor.delete_selected"
    },
    "placement": {
      "tool_key": "editor.tool.mode",
      "snap_key": "editor.grid.size",
      "grid_size_key": "editor.grid.size",
      "elevation_key": "editor.brush.elevation",
      "work_plane_distance_key": "editor.work_plane.distance",
      "floor_material": "mat.editor.floor",
      "ceiling_material": "mat.editor.ceiling",
      "default_snap": 8.0,
      "default_grid_size": 8.0,
      "default_elevation": 0.0,
      "outputs": {
        "active_key": "editor.placement_preview.active",
        "valid_key": "editor.placement_preview.valid",
        "mode_key": "editor.placement_preview.mode",
        "kind_key": "editor.placement_preview.kind",
        "axis_key": "editor.placement_preview.axis",
        "world_key": "editor.placement_preview.world",
        "material_key": "editor.placement_preview.material",
        "message_key": "editor.placement_preview.message",
        "anchor_key": "editor.placement_preview.anchor",
        "snap_key": "editor.placement_preview.snap",
        "bounds_min_key": "editor.placement_preview.bounds_min",
        "bounds_max_key": "editor.placement_preview.bounds_max",
        "overlap_count_key": "editor.placement_preview.overlaps"
      },
      "previews": [
        {
          "mode": "floor",
          "kind": "box",
          "world": "brush.editor_shell.target",
          "material": "mat.editor.floor",
          "elevation_mode": "connected_grid",
          "grid_min": [0.0, -0.025, 0.0],
          "grid_max": [1.0, 0.0, 1.0],
          "message": "floor prefab preview"
        },
        {
          "mode": "wall",
          "kind": "box",
          "world": "brush.editor_shell.target",
          "material": "mat.editor.wall",
          "axis_key": "editor.placement.wall_axis",
          "axis": "z",
          "auto_axis": "camera_cardinal",
          "auto_axis_camera": "camera.editor_shell.viewport",
          "auto_axis_view_key": "editor.view.mode",
          "auto_axis_view": "flyby_3d",
          "elevation_mode": "connected_grid",
          "grid_min": [0.0, 0.0, -0.0125],
          "grid_max": [1.0, 1.0, 0.0125],
          "message": "wall prefab preview"
        },
        {
          "mode": "ceiling",
          "kind": "box",
          "world": "brush.editor_shell.target",
          "material": "mat.editor.ceiling",
          "elevation_mode": "connected_grid",
          "grid_min": [0.0, 1.0, 0.0],
          "grid_max": [1.0, 1.025, 1.0],
          "message": "ceiling prefab preview"
        },
        {
          "mode": "sky",
          "kind": "box",
          "world": "brush.editor_shell.target",
          "material": "mat.editor.sky",
          "contents": ["sky", "player_clip", "projectile_clip"],
          "elevation_mode": "connected_grid",
          "grid_min": [0.0, 1.0, 0.0],
          "grid_max": [1.0, 1.025, 1.0],
          "message": "sky prefab preview"
        },
        {
          "mode": "player_start",
          "kind": "player_start",
          "snap": 1.0,
          "snap_mode": "nearest",
          "size": [0.5, 1.8, 0.5],
          "message": "player start preview"
        }
      ]
    },
    "palette": {
      "selected_key": "editor.tool.mode",
      "entries": [
        {
          "mode": "floor",
          "preview": "floor",
          "kind": "box",
          "label": "Floor",
          "category": "blockout",
          "description": "8m gray floor tile"
        },
        {
          "mode": "wall",
          "preview": "wall",
          "kind": "box",
          "label": "Wall",
          "category": "blockout",
