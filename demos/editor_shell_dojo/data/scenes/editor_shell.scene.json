    "debug_overlay": {
      "enabled": true,
      "hover_selection_if": {
        "type": "scene_state.compare",
        "key": "editor.view.mode",
        "op": "==",
        "value": "flyby_3d"
      },
      "flags": [
        "work_plane_grid",
        "world_bounds",
        "player_starts",
        "selection_bounds",
        "selection_face",
        "trace_ray",
        "face_normal",
        "hit_marker",
        "command_preview",
        "markers"
