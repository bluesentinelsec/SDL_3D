      "world_bounds_color": [80, 170, 255, 190],
      "selection_bounds_color": [255, 220, 40, 255],
      "selection_face_color": [95, 255, 180, 255],
      "trace_color": [255, 255, 255, 210],
      "face_normal_color": [40, 255, 120, 255],
      "hit_marker_color": [255, 70, 70, 255],
      "command_preview_color": [80, 255, 180, 255],
      "work_plane_grid_color": [80, 140, 170, 95],
      "player_start_color": [80, 255, 130, 255],
      "work_plane_grid_size": 256.0,
      "work_plane_grid_spacing": 1.0,
      "normal_length": 0.65,
      "hit_marker_size": 0.12,
      "player_start_radius": 0.35,
      "player_start_height": 1.8,
      "markers": [
        {
          "name": "editor.leak.point",
          "point_key": "editor.leak.point",
          "color": [255, 60, 230, 255],
          "size": 1.2,
          "visible_if": {
            "type": "all",
            "conditions": [
              { "type": "scene_state.compare", "key": "editor.leak.valid", "op": "==", "value": false },
              { "type": "scene_state.compare", "key": "editor.leak.open_boundaries", "op": ">", "value": 0 }
            ]
          }
        },
        {
          "name": "editor.leak.candidate",
          "point_key": "editor.leak.candidate_point",
          "color": [255, 170, 40, 255],
          "size": 0.9,
          "visible_if": {
            "type": "all",
            "conditions": [
              { "type": "scene_state.compare", "key": "editor.leak.valid", "op": "==", "value": false },
              { "type": "scene_state.compare", "key": "editor.leak.open_boundaries", "op": ">", "value": 0 },
              { "type": "scene_state.compare", "key": "editor.leak.candidate_face", "op": "!=", "value": "", "default": "" }
            ]
          }
        }
      ]
    }
  },
