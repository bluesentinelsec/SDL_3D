{
  "schema": "slayer3d.fragment.v0",
  "assets": {
    "fonts": [
      { "id": "font.fps.hud", "builtin": "Inter", "size": 22 },
      { "id": "font.fps.title", "builtin": "Inter", "size": 34 }
    ]
  },
  "ui": {
    "widgets": [
      {
        "id": "ui.fps.reticle",
        "type": "label",
        "font": "font.fps.hud",
        "text": "+",
        "x": 630,
        "y": 338,
        "w": 20,
        "h": 44
      },
      {
        "id": "ui.fps.fps_counter",
        "type": "label",
        "font": "font.fps.hud",
        "format": "FPS %s",
        "bindings": [{ "type": "metric", "metric": "fps", "default": 0 }],
        "x": 1110,
        "y": 18,
        "w": 150,
        "h": 28
      },
      {
        "id": "ui.fps.resources",
        "type": "label",
        "font": "font.fps.hud",
        "format": "HP %s/%s  Armor %s  Ammo %s/%s",
        "bindings": [
          { "type": "property", "entity": "entity.player", "key": "health", "default": 0 },
          { "type": "property", "entity": "entity.player", "key": "max_health", "default": 0 },
          { "type": "property", "entity": "entity.player", "key": "armor", "default": 0 },
          { "type": "property", "entity": "entity.player", "key": "ammo", "default": 0 },
          { "type": "property", "entity": "entity.player", "key": "max_ammo", "default": 0 }
        ],
        "x": 24,
        "y": 668,
        "w": 560,
        "h": 28
      },
      {
        "id": "ui.fps.pause.title",
        "type": "label",
        "font": "font.fps.title",
        "text": "PAUSED",
        "x": 530,
        "y": 300,
        "w": 220,
        "h": 44,
        "visible_if": { "type": "app.paused", "equals": true }
      }
    ]
  }
}
