{
  "schema": "sdl3d.game.v0",
  "imports": [
    { "path": "fragments/assets.json", "sections": ["assets"] },
    { "path": "fragments/scripts.json", "sections": ["scripts"] },
    { "path": "fragments/input/actions.json", "sections": ["input"] },
    { "path": "fragments/input/device_assignments.json", "sections": ["input"] },
    { "path": "fragments/input/profiles.json", "sections": ["input"] },
    { "path": "fragments/network/protocol.json", "sections": ["network"] },
    { "path": "fragments/network/session_flow.json", "sections": ["network"] },
    { "path": "fragments/network/runtime_bindings.json", "sections": ["network"] },
    { "path": "fragments/network/replication.json", "sections": ["network"] },
    { "path": "fragments/network/control_messages.json", "sections": ["network"] },
    { "path": "fragments/logic/menus.json", "sections": ["logic"] },
    { "path": "fragments/logic/options.json", "sections": ["logic"] },
    { "path": "fragments/logic/gameplay_collisions.json", "sections": ["logic"] },
    { "path": "fragments/logic/gameplay_rounds.json", "sections": ["logic"] },
    { "path": "fragments/logic/gameplay_score.json", "sections": ["logic"] },
    { "path": "fragments/logic/gameplay_camera.json", "sections": ["logic"] },
    { "path": "fragments/logic/title_attract.json", "sections": ["logic"] },
    { "path": "fragments/logic/network.json", "sections": ["logic"] },
    { "path": "fragments/presentation.json", "sections": ["presentation", "transitions", "haptics"] },
    { "path": "fragments/persistence.json", "sections": ["storage", "persistence"] },
    { "path": "fragments/runtime.json", "sections": ["render", "update_phases", "profiles"] },
    { "path": "fragments/interaction.json", "sections": ["ui", "signals", "adapters"] },
    { "path": "fragments/actors/field_base.json", "sections": ["entities"] },
    { "path": "fragments/actors/field_borders.json", "sections": ["entities"] },
    { "path": "fragments/actors/paddles.json", "sections": ["entities"] },
    { "path": "fragments/actors/ball.json", "sections": ["entities"] },
    { "path": "fragments/actors/state.json", "sections": ["entities"] },
    { "path": "fragments/actors/options_base.json", "sections": ["entities"] },
    { "path": "fragments/actors/options_glows.json", "sections": ["entities"] },
    { "path": "fragments/actors/options_flows.json", "sections": ["entities"] },
    { "path": "fragments/actors/multiplayer_base.json", "sections": ["entities"] },
    { "path": "fragments/actors/multiplayer_effects.json", "sections": ["entities"] }
  ],
  "metadata": {
    "name": "Pong",
    "id": "demo.pong",
    "version": "0.1.0",
    "description": "Fixed-screen arcade proof that SDL3D gameplay rules can be authored through generic entities, sensors, signals, timers, and actions."
  },
  "app": {
    "title": "SDL3D Pong",
    "logical_width": 1280,
    "logical_height": 720,
    "backend": "opengl",
    "window": {
      "display_mode": "windowed",
      "development_display_mode": "windowed",
      "production_display_mode": "windowed",
      "maximized": true,
      "resizable": true,
      "vsync": true,
      "renderer": "opengl",
      "apply_signal": "signal.settings.apply",
      "apply_signals": [
        "signal.settings.apply",
        "signal.settings.reset_display"
      ],
      "settings": {
        "target": "entity.settings",
        "display_mode": "display_mode",
        "vsync": "vsync",
        "renderer": "renderer"
      }
    },
    "tick_rate": 0.008333333,
    "max_ticks_per_frame": 12,
    "enable_audio": true,
    "pause": {
      "action": "action.pause",
      "allowed_if": {
        "type": "property.compare",
        "target": "entity.match",
        "key": "finished",
        "op": "==",
        "value": false
      }
    },
    "quit": {
      "action": "action.exit",
      "transition": "quit",
      "quit_signal": "signal.app.quit_fade_done"
    },
    "scene_shortcuts": [
      { "action": "action.scene.title", "scene": "scene.title" },
      { "action": "action.scene.options", "scene": "scene.options" },
      { "action": "action.scene.play", "scene": "scene.play" }
    ],
    "input_policy": {
      "global_actions": [
        "action.exit",
        "action.scene.title",
        "action.scene.options",
        "action.scene.play"
      ]
    },
    "scene_transition_policy": {
      "allow_same_scene": false,
      "allow_interrupt": false,
      "reset_menu_input_on_request": true
    }
  },
  "scenes": {
    "initial": "scene.splash",
    "files": [
      "scenes/splash.scene.json",
      "scenes/title.scene.json",
      "scenes/multiplayer.scene.json",
      "scenes/multiplayer_lan.scene.json",
      "scenes/multiplayer_lobby.scene.json",
      "scenes/multiplayer_join.scene.json",
      "scenes/multiplayer_direct_connect.scene.json",
      "scenes/multiplayer_discovery.scene.json",
      { "package": "standard_options" },
      "scenes/play.scene.json"
    ],
    "standard_options": {
      "settings": "entity.settings",
      "return_scene": "scene.title",
      "single_scene": true,
      "menu_state_key": "options_menu",
      "scenes": {
        "root": "scene.options",
        "display": "scene.options.display",
        "keyboard": "scene.options.keyboard",
        "mouse": "scene.options.mouse",
        "gamepad": "scene.options.gamepad",
        "audio": "scene.options.audio"
      },
      "menus": {
        "root": "menu.options",
        "display": "menu.options.display",
        "keyboard": "menu.options.keyboard",
        "mouse": "menu.options.mouse",
        "gamepad": "menu.options.gamepad",
        "audio": "menu.options.audio"
      },
      "actions": {
        "up": "action.menu.up",
        "down": "action.menu.down",
        "left": "action.menu.left",
        "right": "action.menu.right",
        "select": "action.menu.select",
        "back": "action.menu.back"
      },
      "signals": {
        "move": "signal.ui.menu.move",
        "select": "signal.ui.menu.select",
        "apply": "signal.settings.apply",
        "apply_audio": "signal.settings.apply_audio",
        "vibration": "signal.settings.vibration",
        "reset_display": "signal.settings.reset_display",
        "reset_keyboard": "signal.settings.reset_keyboard",
        "reset_mouse": "signal.settings.reset_mouse",
        "reset_gamepad": "signal.settings.reset_gamepad",
        "reset_audio": "signal.settings.reset_audio"
      },
      "fonts": {
        "title": "font.title",
        "menu": "font.hud"
      },
      "transitions": {
        "enter": "scene_in",
        "exit": "scene_out"
      },
      "background": {
        "renders_world": true,
        "camera": "camera.overhead",
        "entities": [
          "entity.options.background.base",
          "entity.options.glow.magenta",
          "entity.options.glow.cyan",
          "entity.options.glow.gold",
          "entity.options.flow.magenta",
          "entity.options.flow.cyan",
          "entity.options.flow.gold"
        ]
      },
      "theme": {
        "title_color": [242, 248, 255, 255],
        "menu_color": [225, 236, 255, 245],
        "selected_color": [255, 245, 208, 255],
        "cursor_color": [255, 222, 140, 255],
        "status_color": [255, 222, 140, 230],
        "divider_color": [126, 168, 238, 170],
        "cursor": ">",
        "slider_left": "[",
        "slider_fill": "#",
        "slider_empty": "-",
        "slider_right": "]"
      },
      "layout": {
        "title_x": 0.5,
        "menu_x": 0.5,
        "status_x": 0.5,
        "status_y": 0.88,
        "menu_align": "left",
        "cursor_align": "right",
        "selected_pulse_alpha": true,
        "title_divider": true,
        "root": {
          "title_y": 0.18,
          "menu_x": 0.43,
          "menu_y": 0.36,
          "gap": 0.078,
          "cursor_offset_x": -0.035
        },
        "display": {
          "title_y": 0.2,
          "menu_x": 0.3,
          "menu_y": 0.38,
          "gap": 0.074,
          "cursor_offset_x": -0.035
        },
        "keyboard": {
          "title_y": 0.13,
          "menu_x": 0.36,
          "menu_y": 0.29,
          "gap": 0.062,
          "cursor_offset_x": -0.035
        },
        "mouse": {
          "title_y": 0.13,
          "menu_x": 0.4,
          "menu_y": 0.30,
          "gap": 0.062,
          "cursor_offset_x": -0.035
        },
        "gamepad": {
          "title_y": 0.105,
          "menu_x": 0.34,
          "menu_y": 0.24,
          "gap": 0.055,
          "cursor_offset_x": -0.035
        },
        "audio": {
          "title_y": 0.18,
          "menu_x": 0.34,
          "menu_y": 0.39,
          "gap": 0.078,
          "cursor_offset_x": -0.035
        }
      },
      "bindings": {
        "keyboard": [
          {
            "label": "Up",
            "default": "UP",
            "bindings": [
              { "action": "action.paddle.up", "device": "keyboard" },
              { "action": "action.menu.up", "device": "keyboard" }
            ]
          },
          {
            "label": "Down",
            "default": "DOWN",
            "bindings": [
              { "action": "action.paddle.down", "device": "keyboard" },
              { "action": "action.menu.down", "device": "keyboard" }
            ]
          },
          {
            "label": "Left",
            "default": "A",
            "bindings": [
              { "action": "action.menu.left", "device": "keyboard" }
            ]
          },
          {
            "label": "Right",
            "default": "D",
            "bindings": [
              { "action": "action.menu.right", "device": "keyboard" }
            ]
          },
          {
            "label": "Accept",
            "default": "RETURN",
            "bindings": [
              { "action": "action.menu.select", "device": "keyboard" },
              { "action": "action.pause", "device": "keyboard" },
              { "action": "action.restart", "device": "keyboard" }
            ]
          },
          {
            "label": "Cancel",
            "default": "BACKSPACE",
            "bindings": [
              { "action": "action.exit", "device": "keyboard" }
            ]
          },
          {
            "label": "Ball Camera",
            "default": "B",
            "bindings": [
              { "action": "action.camera.ball.toggle", "device": "keyboard" }
            ]
          }
        ],
        "mouse": [
          {
            "label": "Accept",
            "default": "LEFT",
            "bindings": [
              { "action": "action.menu.select", "device": "mouse" }
            ]
          }
        ],
        "gamepad": [
          {
            "label": "Up",
            "default": "DPAD_UP",
            "bindings": [
              { "action": "action.paddle.up", "device": "gamepad" },
              { "action": "action.menu.up", "device": "gamepad" }
            ]
          },
          {
            "label": "Down",
            "default": "DPAD_DOWN",
            "bindings": [
              { "action": "action.paddle.down", "device": "gamepad" },
              { "action": "action.menu.down", "device": "gamepad" }
            ]
          },
          {
            "label": "Left",
            "default": "DPAD_LEFT",
            "bindings": [
              { "action": "action.menu.left", "device": "gamepad" }
            ]
          },
          {
            "label": "Right",
            "default": "DPAD_RIGHT",
            "bindings": [
              { "action": "action.menu.right", "device": "gamepad" }
            ]
          },
          {
            "label": "Accept",
            "default": "SOUTH",
            "bindings": [
              { "action": "action.menu.select", "device": "gamepad" },
              { "action": "action.restart", "device": "gamepad" }
            ]
          },
          {
            "label": "Cancel",
            "default": "BACK",
            "bindings": [
              { "action": "action.exit", "device": "gamepad" }
            ]
          },
          {
            "label": "Pause",
            "default": "START",
            "bindings": [
              { "action": "action.pause", "device": "gamepad" }
            ]
          },
          {
            "label": "Ball Camera",
            "default": "NORTH",
            "bindings": [
              { "action": "action.camera.ball.toggle", "device": "gamepad" }
            ]
          }
        ]
      }
    }
  },
  "world": {
    "name": "world.pong",
    "kind": "fixed_screen",
    "units": "world_units",
    "axes": {
      "horizontal": "x",
      "vertical": "y",
      "depth": "z"
    },
    "bounds": {
      "min": [-9.0, -5.0, -1.0],
      "max": [9.0, 5.0, 2.0]
    },
    "ambient_light": [0.015, 0.018, 0.026],
    "cameras": [
      {
        "name": "camera.overhead",
        "type": "orthographic",
        "position": [0.0, 0.0, 16.0],
        "target": [0.0, 0.0, 0.0],
        "up": [0.0, 1.0, 0.0],
        "size": 11.4,
        "active": true
      },
      {
        "name": "camera.ball_chase",
        "type": "chase",
        "target_entity": "entity.ball",
        "velocity_property": "velocity",
        "chase_distance": 2.6,
        "height": 1.57,
        "lookahead": 4.4,
        "fovy": 68.0,
        "target_offset": [0.0, 0.0, 0.22],
        "target_z_offset": -0.05,
        "up": [0.0, 0.0, 1.0],
        "active": false
      },
      {
        "name": "camera.attract_ball_chase",
        "type": "chase",
        "target_entity": "entity.ball.attract",
        "velocity_property": "velocity",
        "chase_distance": 2.6,
        "height": 1.57,
        "lookahead": 4.4,
        "fovy": 68.0,
        "target_offset": [0.0, 0.0, 0.22],
        "target_z_offset": -0.05,
        "up": [0.0, 0.0, 1.0],
        "active": false
      }
    ],
    "lights": [
      {
        "name": "light.left_red_spot",
        "type": "spot",
        "position": [-8.15, 0.0, 3.35],
        "direction": [0.0, 0.0, -1.0],
        "color": [1.0, 0.06, 0.04],
        "intensity": 12.5,
        "range": 8.4,
        "inner_cutoff": 0.86,
        "outer_cutoff": 0.48,
        "effects": [
          { "type": "color_cycle", "duration": 8.0, "phase": 0.05, "colors": [[1.0, 0.06, 0.04], [1.0, 0.34, 0.08], [1.0, 0.12, 0.34]], "color_blend": 1.0 }
        ]
      },
      {
        "name": "light.gold_ball_spot",
        "type": "spot",
        "target_entities": ["entity.ball", "entity.ball.attract"],
        "offset": [0.0, 0.0, 2.8],
        "direction": [0.0, 0.0, -1.0],
        "color": [1.0, 0.82, 0.42],
        "intensity": 8.0,
        "range": 5.8,
        "inner_cutoff": 0.92,
        "outer_cutoff": 0.58,
        "effects": [
          { "type": "pulse", "rate": 1.7, "color": [1.0, 0.92, 0.58], "color_blend": 0.22, "intensity_add": 0.55, "range_add": 0.35 },
          { "type": "flash", "source": "entity.presentation", "property": "border_flash", "color": [0.65, 0.78, 1.0], "color_blend": 0.45, "intensity_add": 1.3, "range_add": 1.0 },
          { "type": "flash", "source": "entity.presentation", "property": "paddle_flash", "color": [1.0, 1.0, 1.0], "color_blend": 0.35, "intensity_add": 1.1, "range_add": 0.8 }
        ]
      },
      {
        "name": "light.right_blue_spot",
        "type": "spot",
        "position": [8.15, 0.0, 3.35],
        "direction": [0.0, 0.0, -1.0],
        "color": [0.08, 0.28, 1.0],
        "intensity": 12.5,
        "range": 8.4,
        "inner_cutoff": 0.86,
        "outer_cutoff": 0.48,
        "effects": [
          { "type": "color_cycle", "duration": 8.5, "phase": 0.35, "colors": [[0.08, 0.28, 1.0], [0.12, 0.72, 1.0], [0.34, 0.18, 1.0]], "color_blend": 1.0 }
        ]
      }
    ]
  }
}
