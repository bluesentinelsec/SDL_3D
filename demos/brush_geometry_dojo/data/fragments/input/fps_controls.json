{
  "schema": "slayer3d.fragment.v0",
  "input": {
    "contexts": [
      {
        "name": "input.brush_geometry.fps",
        "actions": [
          { "name": "action.move.forward", "bindings": [{ "device": "keyboard", "key": "W" }] },
          { "name": "action.move.back", "bindings": [{ "device": "keyboard", "key": "S" }] },
          { "name": "action.move.left", "bindings": [{ "device": "keyboard", "key": "A" }] },
          { "name": "action.move.right", "bindings": [{ "device": "keyboard", "key": "D" }] },
          { "name": "action.jump", "bindings": [{ "device": "keyboard", "key": "SPACE" }] },
          { "name": "action.use", "bindings": [{ "device": "keyboard", "key": "E" }] },
          { "name": "action.camera.security.toggle", "bindings": [{ "device": "keyboard", "key": "V" }] },
          { "name": "action.gun_tune.toggle", "bindings": [{ "device": "keyboard", "key": "G" }] },
          { "name": "action.smoke_tune.toggle", "bindings": [{ "device": "keyboard", "key": "H" }] },
          { "name": "action.gun_tune.x_neg", "bindings": [{ "device": "keyboard", "key": "LEFT" }] },
          { "name": "action.gun_tune.x_pos", "bindings": [{ "device": "keyboard", "key": "RIGHT" }] },
          { "name": "action.gun_tune.y_pos", "bindings": [{ "device": "keyboard", "key": "UP" }] },
          { "name": "action.gun_tune.y_neg", "bindings": [{ "device": "keyboard", "key": "DOWN" }] },
          { "name": "action.gun_tune.z_neg", "bindings": [{ "device": "keyboard", "key": "Z" }] },
          { "name": "action.gun_tune.z_pos", "bindings": [{ "device": "keyboard", "key": "X" }] },
          { "name": "action.gun_tune.scale_down", "bindings": [{ "device": "keyboard", "key": "COMMA" }] },
          { "name": "action.gun_tune.scale_up", "bindings": [{ "device": "keyboard", "key": "PERIOD" }] },
          { "name": "action.gun_tune.pitch_up", "bindings": [{ "device": "keyboard", "key": "I" }] },
          { "name": "action.gun_tune.pitch_down", "bindings": [{ "device": "keyboard", "key": "K" }] },
          { "name": "action.gun_tune.yaw_neg", "bindings": [{ "device": "keyboard", "key": "J" }] },
          { "name": "action.gun_tune.yaw_pos", "bindings": [{ "device": "keyboard", "key": "L" }] },
          { "name": "action.gun_tune.roll_neg", "bindings": [{ "device": "keyboard", "key": "U" }] },
          { "name": "action.gun_tune.roll_pos", "bindings": [{ "device": "keyboard", "key": "O" }] },
          { "name": "action.gun_tune.write", "bindings": [{ "device": "keyboard", "key": "P" }] },
          {
            "name": "action.fire",
            "bindings": [
              { "device": "mouse", "button": "LEFT" },
              { "device": "keyboard", "key": "F" }
            ]
          }
        ]
      }
    ]
  }
}
