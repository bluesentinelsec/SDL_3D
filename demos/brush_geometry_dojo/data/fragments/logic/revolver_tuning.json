        ]
      },
      {
        "signal": "signal.gun_tune.scale_up",
        "actions": [
          { "type": "branch", "if": { "type": "scene_state.compare", "key": "debug.revolver_tuning.enabled", "op": "==", "value": true }, "then": [{ "type": "property.add", "target": "entity.brush_geometry.revolver_viewmodel", "key": "gun_scale", "value": 0.01 }] }
        ]
      },
      {
        "signal": "signal.gun_tune.pitch_down",
        "actions": [
          { "type": "branch", "if": { "type": "scene_state.compare", "key": "debug.revolver_tuning.enabled", "op": "==", "value": true }, "then": [{ "type": "property.add", "target": "entity.brush_geometry.revolver_viewmodel", "key": "gun_pitch", "value": -0.025 }] }
