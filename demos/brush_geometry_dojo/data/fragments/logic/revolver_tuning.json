      { "name": "sensor.gun_tune.scale_down", "type": "sensor.input_pressed", "action": "action.gun_tune.scale_down", "on_pressed": "signal.gun_tune.scale_down" },
      { "name": "sensor.gun_tune.scale_up", "type": "sensor.input_pressed", "action": "action.gun_tune.scale_up", "on_pressed": "signal.gun_tune.scale_up" },
      { "name": "sensor.gun_tune.pitch_down", "type": "sensor.input_pressed", "action": "action.gun_tune.pitch_down", "on_pressed": "signal.gun_tune.pitch_down" },
