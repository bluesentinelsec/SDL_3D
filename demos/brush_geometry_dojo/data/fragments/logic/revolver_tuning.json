        ]
      },
      {
        "signal": "signal.gun_tune.yaw_neg",
        "actions": [
          { "type": "branch", "if": { "type": "scene_state.compare", "key": "debug.revolver_tuning.enabled", "op": "==", "value": true }, "then": [{ "type": "property.add", "target": "entity.brush_geometry.revolver_viewmodel", "key": "gun_yaw", "value": -0.025 }] }
        ]
      },
      {
