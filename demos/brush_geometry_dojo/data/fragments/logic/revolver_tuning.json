          { "type": "branch", "if": { "type": "scene_state.compare", "key": "debug.revolver_smoke_tuning.enabled", "op": "==", "value": true }, "then": [{ "type": "property.add", "target": "entity.brush_geometry.revolver_smoke_config", "key": "smoke_offset_x", "value": -0.02 }] },
