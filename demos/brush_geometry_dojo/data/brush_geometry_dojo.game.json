{
  "schema": "slayer3d.game.v0",
  "metadata": {
    "name": "Slayer 3D Brush Geometry Dojo",
    "id": "demo.brush_geometry_dojo",
    "version": "0.1.0"
  },
  "imports": [
    { "path": "fragments/input/fps_controls.json", "sections": ["input"] },
    { "path": "fragments/actors/player.json", "sections": ["entities"] },
    { "path": "fragments/actors/gameplay_targets.json", "sections": ["entities"] },
    { "path": "fragments/actors/showcase_primitives.json", "sections": ["entities"] },
    { "path": "fragments/actors/billboard_sprites.json", "sections": ["assets", "entities"] },
    { "path": "fragments/actors/zombie_actor.json", "sections": ["assets", "entities"] },
    { "path": "fragments/actors/revolver_viewmodel.json", "sections": ["assets", "entities"] },
    { "path": "fragments/actors/mechanics_props.json", "sections": ["entities"] },
    { "path": "fragments/actors/projectiles.json", "sections": ["actor_archetypes", "actor_pools"] },
    { "path": "fragments/actors/revolver_effects.json", "sections": ["actor_archetypes", "actor_pools"] },
    { "path": "fragments/world/showcase.brushes.json", "sections": ["brush_worlds"] },
    { "path": "fragments/world/doors.json", "sections": ["assets", "sector_doors", "signals", "logic"] },
    { "path": "fragments/actors/lights.json", "sections": ["entities"] },
    { "path": "fragments/logic/movement_mechanics.json", "sections": ["signals", "logic"] },
    { "path": "fragments/logic/revolver_runtime.json", "sections": ["signals", "logic"] },
    { "path": "fragments/logic/revolver_tuning.json", "sections": ["signals", "logic"] },
    { "path": "fragments/logic/brush_gameplay_sensors.json", "sections": ["logic"] }
  ],
  "app": {
    "title": "Slayer 3D Brush Geometry Dojo",
    "logical_width": 1280,
    "logical_height": 720,
    "backend": "opengl",
    "window": { "renderer": "opengl", "vsync": false },
    "quit": { "action": "action.exit" },
    "input_policy": { "global_actions": ["action.exit"] }
  },
  "input": {
    "contexts": [
      {
        "name": "input.brush_geometry_dojo",
        "actions": [
          {
            "name": "action.exit",
            "bindings": [
              { "device": "keyboard", "key": "ESCAPE" }
            ]
          }
        ]
      }
    ]
  },
  "world": {
    "name": "world.brush_geometry_dojo",
    "kind": "brush",
    "units": "meters",
    "meters_per_unit": 1.0,
    "ambient_light": [0.16, 0.17, 0.18],
    "cameras": [
      {
        "name": "camera.brush_geometry.player",
        "type": "fps",
        "target_entity": "entity.brush_geometry.player",
        "fov": 90.0,
        "fov_axis": "horizontal",
        "active": true
      },
      {
        "name": "camera.brush_geometry.security",
        "type": "perspective",
        "position_entity": "entity.brush_geometry.security_eye",
        "target_entity": "entity.brush_geometry.security_view_target",
        "up": [0.0, 1.0, 0.0],
        "fov": 66.0,
        "fov_axis": "horizontal"
      }
    ]
  },
  "assets": {
    "fonts": [
      { "id": "font.brush_geometry.hud", "builtin": "Inter", "size": 22 }
    ],
    "images": [
      { "id": "image.brush_geometry.skybox.px", "path": "asset://skyboxes/sky_17/px.png" },
      { "id": "image.brush_geometry.skybox.nx", "path": "asset://skyboxes/sky_17/nx.png" },
      { "id": "image.brush_geometry.skybox.py", "path": "asset://skyboxes/sky_17/py.png" },
      { "id": "image.brush_geometry.skybox.ny", "path": "asset://skyboxes/sky_17/ny.png" },
      { "id": "image.brush_geometry.skybox.pz", "path": "asset://skyboxes/sky_17/pz.png" },
      { "id": "image.brush_geometry.skybox.nz", "path": "asset://skyboxes/sky_17/nz.png" }
    ]
  },
  "render": {
    "lighting": true,
    "depth_prepass": true,
    "depth_prepass_key": "debug.render.depth_prepass.enabled",
    "per_object_light_selection": true,
    "per_object_light_selection_key": "debug.render.per_object_lights.enabled",
    "per_object_light_limit": 4,
    "procedural_lod": true,
    "procedural_lod_key": "debug.render.procedural_lod.enabled",
    "procedural_lod_near_pixels": 150.0,
    "procedural_lod_far_pixels": 26.0,
    "procedural_lod_min_segments": 8,
    "model_lod_culling": true,
    "model_lod_culling_key": "debug.render.model_lod.enabled",
    "model_lod_cull_pixels": 3.0,
    "performance_queries": true,
    "world_render_scale": 1.0,
    "world_render_scale_key": "debug.render.world_scale",
    "bloom": false,
    "ssao": false,
    "clear_color": [0.035, 0.04, 0.05]
  },
  "presentation": {
    "metrics": { "fps_sample_seconds": 0.25 }
  },
  "scenes": {
    "initial": "scene.brush_geometry.showcase",
    "files": ["scenes/showcase.scene.json"]
  }
}
