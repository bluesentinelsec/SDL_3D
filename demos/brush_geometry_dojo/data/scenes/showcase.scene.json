{
  "schema": "slayer3d.scene.v0",
  "name": "scene.brush_geometry.showcase",
  "camera": "camera.brush_geometry.player",
  "updates_game": true,
  "renders_world": true,
  "entities": [
    "entity.brush_geometry.player",
    "entity.brush_geometry.revolver_viewmodel",
    "entity.brush_geometry.revolver_smoke_config",
    "entity.brush_geometry.revolver_muzzle_flash_config",
    "entity.brush_geometry.revolver_pickup",
    "entity.brush_geometry.visible_target",
    "entity.brush_geometry.occluded_target",
    "entity.brush_geometry.zombie",
    "entity.brush_geometry.mesh.cube",
    "entity.brush_geometry.mesh.sphere",
    "entity.brush_geometry.mesh.capsule",
    "entity.brush_geometry.mesh.cylinder",
    "entity.brush_geometry.mesh.cone",
    "entity.brush_geometry.mesh.torus",
    "entity.brush_geometry.mesh.pyramid",
    "entity.brush_geometry.mesh.wedge",
    "entity.brush_geometry.mesh.plane",
    "entity.brush_geometry.mesh.disc",
    "entity.brush_geometry.mesh.hemisphere",
    "entity.brush_geometry.mesh.rounded_box",
    "entity.brush_geometry.mesh.pipe",
    "entity.brush_geometry.mesh.arrow",
    "entity.brush_geometry.mesh.billboard_plane",
    "entity.brush_geometry.mock.robot",
    "entity.brush_geometry.sprite.robot",
    "entity.brush_geometry.sprite.health",
    "entity.brush_geometry.jump_pad",
    "entity.brush_geometry.teleport_pad",
    "entity.brush_geometry.teleport_target",
    "entity.brush_geometry.conveyor_marker",
    "entity.brush_geometry.security_camera",
    "entity.brush_geometry.security_eye",
    "entity.brush_geometry.security_view_target",
    "entity.brush_geometry.security_monitor",
    "entity.brush_geometry.sun",
    "entity.brush_geometry.blue_fill",
    "entity.brush_geometry.courtyard_blue",
    "entity.brush_geometry.courtyard_red",
    "entity.brush_geometry.bridge_gold",
    "entity.brush_geometry.east_room_red",
    "entity.brush_geometry.tower_red",
    "entity.brush_geometry.tower_blue_shadow"
  ],
  "input": {
    "mouse_capture": "unpaused",
    "actions": [
      "action.move.forward",
      "action.move.back",
      "action.move.left",
      "action.move.right",
      "action.jump",
      "action.use",
      "action.camera.security.toggle",
      "action.fire",
      "action.gun_tune.toggle",
      "action.smoke_tune.toggle",
      "action.muzzle_tune.toggle",
      "action.gun_tune.x_neg",
      "action.gun_tune.x_pos",
      "action.gun_tune.y_neg",
      "action.gun_tune.y_pos",
      "action.gun_tune.z_neg",
      "action.gun_tune.z_pos",
      "action.gun_tune.scale_down",
      "action.gun_tune.scale_up",
      "action.gun_tune.pitch_down",
      "action.gun_tune.pitch_up",
      "action.gun_tune.yaw_neg",
      "action.gun_tune.yaw_pos",
      "action.gun_tune.roll_neg",
      "action.gun_tune.roll_pos",
      "action.gun_tune.write",
      "action.exit"
    ]
  },
  "activity": {
    "enabled": true,
    "reset_periodic_on_input": false,
    "periodic": [
      {
        "interval": 0.06,
        "actions": [
          {
            "type": "branch",
            "if": {
              "type": "all",
              "conditions": [
                { "type": "scene_state.compare", "key": "debug.revolver_muzzle_tuning.enabled", "op": "==", "value": true },
                { "type": "property.compare", "target": "entity.brush_geometry.player", "key": "revolver", "op": ">", "value": 0 }
              ]
            },
            "then": [
              {
                "type": "actor.spawn",
                "pool": "pool.brush_geometry.revolver_muzzle_flashes",
                "position_from_actor_properties": {
                  "source": "entity.brush_geometry.revolver_viewmodel",
                  "x": "gun_x",
                  "y": "gun_y",
                  "z": "gun_z"
                },
                "properties_from_actor": {
                  "source": "entity.brush_geometry.revolver_muzzle_flash_config",
                  "keys": [
                    "flash_offset_x",
                    "flash_offset_y",
                    "flash_offset_z",
                    "flash_size_scale",
                    "flash_alpha_scale",
                    "flash_intensity"
                  ]
                }
              }
            ]
          },
          {
            "type": "branch",
            "if": {
              "type": "all",
              "conditions": [
                { "type": "scene_state.compare", "key": "debug.revolver_smoke_tuning.enabled", "op": "==", "value": true },
                { "type": "property.compare", "target": "entity.brush_geometry.player", "key": "revolver", "op": ">", "value": 0 }
              ]
            },
            "then": [
              {
                "type": "actor.spawn",
                "pool": "pool.brush_geometry.revolver_smoke",
                "position_from_actor_properties": {
                  "source": "entity.brush_geometry.revolver_viewmodel",
                  "x": "gun_x",
                  "y": "gun_y",
                  "z": "gun_z"
                },
                "properties_from_actor": {
                  "source": "entity.brush_geometry.revolver_smoke_config",
                  "keys": [
                    "smoke_offset_x",
                    "smoke_offset_y",
                    "smoke_offset_z",
                    "smoke_size_scale",
                    "smoke_alpha_scale",
                    "smoke_emit_rate"
                  ]
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "world": {
    "skybox": {
      "pos_x": "image.brush_geometry.skybox.px",
      "neg_x": "image.brush_geometry.skybox.nx",
      "pos_y": "image.brush_geometry.skybox.py",
      "neg_y": "image.brush_geometry.skybox.ny",
      "pos_z": "image.brush_geometry.skybox.pz",
      "neg_z": "image.brush_geometry.skybox.nz",
      "size": 400.0
    },
    "brush_worlds": [
      {
        "world": "brush.brush_geometry.showcase",
        "position": [0.0, 0.0, 0.0],
        "acceleration": true,
        "lighting": true,
        "debug_wireframe": false
      }
    ]
  },
  "ui": {
    "text": [
      {
        "name": "ui.brush_geometry.title",
        "text": "Brush Geometry Dojo",
        "font": "font.brush_geometry.hud",
        "x": 0.02,
        "y": 0.03,
        "normalized": true,
        "color": [235, 240, 250, 230],
        "scale": 0.85
      },
      {
        "name": "ui.brush_geometry.help",
        "text": "WASD move  Mouse look  Space jump  E use  V camera  N z-prepass  F/Mouse fire  Esc quit",
        "font": "font.brush_geometry.hud",
        "x": 0.02,
        "y": 0.075,
        "normalized": true,
        "color": [205, 215, 230, 210],
        "scale": 0.62
      },
      {
        "name": "ui.brush_geometry.gun_tuning_hint",
        "text": "G gun tuning  H smoke tuning  M muzzle tuning",
        "font": "font.brush_geometry.hud",
        "x": 0.02,
        "y": 0.105,
        "normalized": true,
        "color": [190, 235, 185, 205],
        "scale": 0.52
      },
      {
        "name": "ui.brush_geometry.gun_tuning_active",
        "text": "GUN TUNE ENABLED",
        "font": "font.brush_geometry.hud",
        "x": 0.02,
        "y": 0.135,
        "normalized": true,
        "color": [145, 255, 155, 230],
        "scale": 0.62,
        "visible_if": { "type": "scene_state.compare", "key": "debug.revolver_tuning.enabled", "op": "==", "value": true }
      },
      {
        "name": "ui.brush_geometry.gun_tuning_move",
        "text": "Move: Left/Right = X    Up/Down = Y    Z/X = depth",
        "font": "font.brush_geometry.hud",
        "x": 0.02,
        "y": 0.17,
        "normalized": true,
        "color": [145, 255, 155, 230],
        "scale": 0.54,
        "visible_if": { "type": "scene_state.compare", "key": "debug.revolver_tuning.enabled", "op": "==", "value": true }
      },
      {
        "name": "ui.brush_geometry.gun_tuning_rotate",
        "text": "Rotate: I/K = pitch    J/L = yaw    U/O = roll",
        "font": "font.brush_geometry.hud",
        "x": 0.02,
        "y": 0.202,
        "normalized": true,
        "color": [145, 255, 155, 230],
        "scale": 0.54,
        "visible_if": { "type": "scene_state.compare", "key": "debug.revolver_tuning.enabled", "op": "==", "value": true }
      },
      {
        "name": "ui.brush_geometry.gun_tuning_scale",
        "text": "Scale: comma = smaller    period = bigger    P = write /tmp/gun-placement.txt",
        "font": "font.brush_geometry.hud",
        "x": 0.02,
        "y": 0.234,
        "normalized": true,
        "color": [145, 255, 155, 230],
        "scale": 0.54,
        "visible_if": { "type": "scene_state.compare", "key": "debug.revolver_tuning.enabled", "op": "==", "value": true }
      },
      {
        "name": "ui.brush_geometry.smoke_tuning_active",
        "text": "SMOKE TUNE ENABLED",
        "font": "font.brush_geometry.hud",
