          { "type": "entity.set_active", "target": "entity.dojo.health_pickup", "active": true },
          { "type": "entity.set_active", "target": "entity.dojo.powerup", "active": true },
          { "type": "sector_door.open", "target": "door.dojo.hazard_gate" }
        ]
      },
      {
