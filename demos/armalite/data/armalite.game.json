          { "type": "color_cycle", "duration": 6.0, "phase": 0.0, "colors": [[0.05, 0.62, 1.0], [0.30, 1.0, 0.80], [0.10, 0.28, 1.0]], "color_blend": 1.0 },
          { "type": "pulse", "rate": 2.4, "color": [0.70, 1.0, 1.0], "color_blend": 0.15, "intensity_add": 1.6, "range_add": 0.6 }
        ]
      },
      {
        "name": "light.enemy.red",
        "type": "spot",
        "position": [5.7, 1.8, 3.4],
        "direction": [-0.55, -0.12, -1.0],
        "color": [1.0, 0.08, 0.28],
