        ]
      },
      {
        "name": "light.asteroid.green",
        "type": "spot",
        "position": [3.2, -3.0, 2.9],
        "direction": [-0.18, 0.28, -1.0],
        "color": [0.24, 1.0, 0.48],
        "intensity": 8.0,
        "range": 6.8,
        "inner_cutoff": 0.82,
        "outer_cutoff": 0.42,
        "effects": [
          { "type": "pulse", "rate": 1.6, "color": [0.70, 1.0, 0.72], "color_blend": 0.24, "intensity_add": 1.0, "range_add": 0.55 }
        ]
      }
    ]
  }
}

