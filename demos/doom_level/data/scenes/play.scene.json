        "w": 1.0,
        "h": 0.08,
        "normalized": true,
        "color": [220, 20, 20, 170],
        "alpha_source": {
          "target": "entity.player",
          "key": "last_damage_per_second",
          "scale": 0.033333,
          "min": 0.35,
          "max": 1.0
        },
        "visible_if": {
          "type": "property.compare",
          "target": "entity.player",
          "key": "last_damage_per_second",
          "op": ">",
          "value": 0.0
