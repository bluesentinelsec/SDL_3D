    "entity.doom.presentation.conveyor.arrow_bottom",
    "entity.doom.presentation.surveillance.base",
    "entity.doom.presentation.surveillance.button",
    "entity.doom.presentation.surveillance.post",
    "entity.doom.presentation.surveillance.camera_body"
  ],
  "input": {
    "mouse_capture": "unpaused",
    "actions": [
      "action.move.forward",
      "action.move.back",
      "action.move.left",
      "action.move.right",
      "action.jump",
      "action.pause",
      "action.interact",
      "action.render.lighting.toggle",
      "action.render.variant.cycle",
      "action.render.portal_culling.toggle",
      "action.render.profile.cycle",
      "action.render.profile.modern",
      "action.render.profile.ps1",
      "action.render.profile.n64",
      "action.render.profile.dos",
      "action.render.profile.snes",
      "action.fire"
    ]
  },
  "world": {
    "skybox": {
      "pos_x": "image.doom.skybox.px",
      "neg_x": "image.doom.skybox.nx",
      "pos_y": "image.doom.skybox.py",
      "neg_y": "image.doom.skybox.ny",
      "pos_z": "image.doom.skybox.pz",
      "neg_z": "image.doom.skybox.nz",
      "size": 400.0
    },
    "sector_levels": [
      {
        "level": "sector.doom.e1m1",
        "variant": "lightmapped",
        "variant_key": "doom.sector.variant",
        "position": [0.0, 0.0, 0.0],
        "portal_culling": true,
        "portal_culling_key": "doom.sector.portal_culling"
      }
    ]
  },
