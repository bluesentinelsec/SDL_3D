{
  "schema": "sdl3d.game.v0",
  "metadata": {
    "name": "SDL3D Doom Level",
    "id": "demo.doom_level",
    "version": "0.1.0"
  },
  "imports": [
    { "path": "fragments/actors/robots.json", "sections": ["assets", "actor_archetypes", "actor_instances"] },
    { "path": "fragments/actors/health.json", "sections": ["assets", "actor_archetypes", "actor_instances"] },
    { "path": "fragments/actors/crates.json", "sections": ["assets", "actor_archetypes", "actor_instances"] },
    { "path": "fragments/actors/dragon.json", "sections": ["assets", "actor_archetypes", "actor_instances"] },
    { "path": "fragments/actors/presentation_props.json", "sections": ["entities"] },
    { "path": "fragments/actors/projectiles.json", "sections": ["actor_archetypes", "actor_pools"] },
    { "path": "fragments/world/sector_materials.json", "sections": ["sector_level_fragments"] },
    { "path": "fragments/world/sector_rooms.json", "sections": ["sector_level_fragments"] },
    { "path": "fragments/world/sector_verticality.json", "sections": ["sector_level_fragments"] },
    { "path": "fragments/world/sector_lights.json", "sections": ["sector_level_fragments"] },
    { "path": "fragments/world/sector_doors.json", "sections": ["assets", "sector_doors", "signals", "logic"] },
    { "path": "fragments/world/sector_platforms.json", "sections": ["sector_platforms"] },
    { "path": "fragments/world/sector_ambient.json", "sections": ["assets", "logic"] },
    { "path": "fragments/world/sector_hazards.json", "sections": ["logic"] },
    { "path": "fragments/world/player_triggers.json", "sections": ["logic"] },
    { "path": "fragments/world/surveillance.json", "sections": ["logic"] },
    { "path": "fragments/world/render_controls.json", "sections": ["signals", "logic"] }
  ],
  "app": {
    "title": "SDL3D Doom Level",
    "logical_width": 1280,
    "logical_height": 720,
    "backend": "opengl",
    "window": { "renderer": "opengl", "vsync": true },
    "audio": { "enabled": true },
    "startup_transition": "startup",
    "pause": { "action": "action.pause" },
    "quit": { "action": "action.exit", "transition": "quit" },
    "input_policy": {
      "global_actions": ["action.exit"]
    }
  },
  "world": {
    "name": "world.doom_level",
    "kind": "sector",
    "units": "meters",
    "meters_per_unit": 1.0,
    "ambient_light": [0.18, 0.18, 0.2],
    "cameras": [
      {
        "name": "camera.doom.player",
        "type": "fps",
        "target_entity": "entity.player",
        "fovy": 90.0,
        "active": true
      },
      {
        "name": "camera.doom.surveillance",
        "type": "perspective",
        "position": [4.0, 3.25, 25.2],
        "target": [4.0, 0.15, 18.4],
        "fovy": 90.0
      }
    ]
  },
  "assets": {
    "fonts": [
      { "id": "font.doom.hud", "builtin": "Inter", "size": 22 },
      { "id": "font.doom.title", "builtin": "Inter", "size": 42 }
    ],
    "images": [
      { "id": "image.doom.skybox.px", "path": "asset://skyboxes/sky_17/px.png" },
      { "id": "image.doom.skybox.nx", "path": "asset://skyboxes/sky_17/nx.png" },
      { "id": "image.doom.skybox.py", "path": "asset://skyboxes/sky_17/py.png" },
      { "id": "image.doom.skybox.ny", "path": "asset://skyboxes/sky_17/ny.png" },
      { "id": "image.doom.skybox.pz", "path": "asset://skyboxes/sky_17/pz.png" },
      { "id": "image.doom.skybox.nz", "path": "asset://skyboxes/sky_17/nz.png" }
    ]
  },
  "input": {
    "contexts": [
      {
        "name": "input.doom_level",
        "actions": [
          { "name": "action.move.forward", "bindings": [{ "device": "keyboard", "key": "W" }] },
          { "name": "action.move.back", "bindings": [{ "device": "keyboard", "key": "S" }] },
          { "name": "action.move.left", "bindings": [{ "device": "keyboard", "key": "A" }] },
          { "name": "action.move.right", "bindings": [{ "device": "keyboard", "key": "D" }] },
          { "name": "action.jump", "bindings": [{ "device": "keyboard", "key": "SPACE" }] },
          { "name": "action.pause", "bindings": [{ "device": "keyboard", "key": "P" }] },
          { "name": "action.exit", "bindings": [{ "device": "keyboard", "key": "ESCAPE" }] },
          { "name": "action.interact", "bindings": [{ "device": "keyboard", "key": "E" }] },
          { "name": "action.render.lighting.toggle", "bindings": [{ "device": "keyboard", "key": "L" }] },
          { "name": "action.render.variant.cycle", "bindings": [{ "device": "keyboard", "key": "M" }] },
          { "name": "action.render.portal_culling.toggle", "bindings": [{ "device": "keyboard", "key": "F2" }] },
          { "name": "action.render.profile.cycle", "bindings": [{ "device": "keyboard", "key": "TAB" }] },
          { "name": "action.render.profile.modern", "bindings": [{ "device": "keyboard", "key": "1" }] },
          { "name": "action.render.profile.ps1", "bindings": [{ "device": "keyboard", "key": "2" }] },
          { "name": "action.render.profile.n64", "bindings": [{ "device": "keyboard", "key": "3" }] },
          { "name": "action.render.profile.dos", "bindings": [{ "device": "keyboard", "key": "4" }] },
          { "name": "action.render.profile.snes", "bindings": [{ "device": "keyboard", "key": "5" }] },
          { "name": "action.render.profile.grayscale", "bindings": [{ "device": "keyboard", "key": "6" }] },
          { "name": "action.render.profile.gameboy", "bindings": [{ "device": "keyboard", "key": "7" }] },
          {
            "name": "action.fire",
            "bindings": [
              { "device": "mouse", "button": "LEFT" },
              { "device": "keyboard", "key": "F" }
            ]
          }
        ]
      }
    ]
  },
  "entities": [
    {
      "name": "entity.player",
      "active": true,
      "transform": { "position": [5.0, 1.6, 4.0] },
      "properties": {
        "yaw": { "type": "float", "value": 3.14159 },
        "pitch": { "type": "float", "value": 0.0 },
        "camera_forward": { "type": "vec3", "value": [0.0, 0.0, -1.0] },
        "current_sector": { "type": "int", "value": -1 },
        "fire_timer": { "type": "float", "value": 0.0 },
        "fire_cooldown": { "type": "float", "value": 0.2 },
        "damage_taken": { "type": "float", "value": 0.0 },
        "last_damage_per_second": { "type": "float", "value": 0.0 }
      },
      "components": [
        {
          "type": "controller.fps_sector",
          "sector_level": "sector.doom.e1m1",
          "actions": {
            "forward": "action.move.forward",
            "back": "action.move.back",
            "left": "action.move.left",
            "right": "action.move.right",
            "jump": "action.jump"
          },
          "move_speed": 12.0,
          "jump_velocity": 6.0,
          "gravity": 14.0,
          "player_height": 1.6,
          "player_radius": 0.35,
          "step_height": 1.1,
          "ceiling_clearance": 0.1,
          "mouse_sensitivity": 0.002
        },
        {
          "type": "property.decay",
          "property": "fire_timer",
          "rate": 1.0,
          "target": 0.0,
          "min": 0.0
        },
        {
          "type": "weapon.projectile",
          "action": "action.fire",
          "pool": "pool.doom.projectiles",
          "velocity_from_property": "camera_forward",
          "speed": 20.0,
          "cooldown_property": "fire_timer"
        }
      ]
    },
    {
      "name": "entity.effect.nukage.vapor",
      "active": true,
      "transform": { "position": [4.0, -0.35, 21.0] },
      "components": [
        {
          "type": "particles.emitter",
          "shape": "box",
          "extents": [5.3, 0.05, 4.2],
          "direction": [0.04, 1.0, -0.03],
          "spread": 1.15,
          "speed_min": 0.35,
          "speed_max": 1.05,
          "lifetime_min": 2.4,
          "lifetime_max": 4.6,
          "size_start": 0.045,
          "size_end": 0.16,
          "color_start": [35, 245, 45, 155],
          "color_end": [0, 185, 55, 0],
          "gravity": -0.16,
          "max_particles": 360,
          "emit_rate": 95.0,
          "camera_facing": true,
          "depth_test": true,
          "additive_blend": true,
          "draw_emissive": [0.25, 0.95, 0.25]
        }
      ]
    }
  ],
  "render": {
    "clear_color": [8, 10, 14, 255],
    "lighting": true,
    "lighting_key": "doom.render.lighting",
    "bloom": true,
    "ssao": false,
    "profile": "modern",
    "profile_key": "doom.render.profile"
  },
  "transitions": {
    "startup": {
      "type": "fade",
      "direction": "in",
      "color": [0, 0, 0, 255],
      "duration": 0.35
    },
    "quit": {
      "type": "fade",
      "direction": "out",
      "color": [0, 0, 0, 255],
      "duration": 0.35
    }
  },
  "scenes": {
    "initial": "scene.doom_level.play",
    "files": ["scenes/play.scene.json"]
  }
}
