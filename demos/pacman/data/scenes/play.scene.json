{
  "schema": "slayer3d.scene.v0",
  "name": "scene.play",
  "updates_game": true,
  "renders_world": true,
  "camera": "camera.maze",
  "on_enter_signal": "signal.game.start",
  "entities": [
    "entity.field.base",
    "entity.field.grid_glow",
    "entity.effect.ambient",
    "entity.pacman",
    "entity.ghost.red",
    "entity.ghost.pink",
    "entity.ghost.cyan",
    "entity.ghost.orange",
    "entity.game",
    "entity.controller",
    "entity.presentation"
  ],
  "input": {
    "actions": [
      "action.move.left",
      "action.move.right",
      "action.move.up",
      "action.move.down",
      "action.pause",
      "action.restart",
      "action.camera.toggle",
      "action.menu.up",
      "action.menu.down",
      "action.menu.select"
    ]
  },
  "transitions": {
    "enter": "scene_in",
    "exit": "scene_out"
  },
  "menus": [
    {
      "name": "menu.pause",
      "active_if": {
        "type": "app.paused",
        "equals": true
      },
      "up_action": "action.menu.up",
      "down_action": "action.menu.down",
      "select_action": "action.menu.select",
      "move_signal": "signal.ui.menu.move",
      "select_signal": "signal.ui.menu.select",
      "selected": 0,
      "items": [
        { "label": "Resume", "pause": "resume" },
        { "label": "Restart", "pause": "resume", "signal": "signal.game.start" },
        { "label": "Title", "pause": "resume", "scene": "scene.title" }
      ]
    }
  ],
  "ui": {
    "text": [
      {
        "name": "ui.hud.status",
        "font": "font.small",
        "format": "SCORE %06d    PELLETS %d    WARNINGS %d    GHOSTS %d",
        "bindings": [
          { "type": "property", "entity": "entity.game", "key": "score" },
          { "type": "property", "entity": "entity.game", "key": "pellets_remaining" },
          { "type": "property", "entity": "entity.game", "key": "defeat_warnings" },
          { "type": "property", "entity": "entity.game", "key": "ghosts_defeated" }
        ],
        "x": 0.5,
        "y": 0.035,
        "normalized": true,
        "centered": true,
        "color": [228, 244, 255, 255]
      },
      {
        "name": "ui.hud.power",
        "font": "font.small",
        "visible_if": {
          "type": "property.compare",
          "target": "entity.game",
          "key": "power_active",
          "op": "==",
          "value": true
        },
        "format": "POWER MODE %.1f",
        "bindings": [
          { "type": "property", "entity": "entity.game", "key": "power_timer" }
        ],
        "x": 0.5,
        "y": 0.085,
        "normalized": true,
        "centered": true,
        "color": [92, 225, 255, 255]
      },
      {
        "name": "ui.hud.fps",
        "font": "font.small",
        "format": "FPS %.0f",
        "bindings": [
          { "type": "metric", "metric": "fps" }
        ],
        "x": 18.0,
        "y": 18.0,
        "color": [132, 164, 210, 220]
      },
      {
        "name": "ui.hud.win",
        "font": "font.hud",
        "visible_if": {
          "type": "property.compare",
          "target": "entity.game",
          "key": "won",
          "op": "==",
          "value": true
        },
        "text": "MAZE CLEARED",
        "x": 0.5,
        "y": 0.17,
        "normalized": true,
        "centered": true,
        "color": [255, 226, 52, 255]
      },
      {
        "name": "ui.controls",
        "font": "font.small",
        "text": "MOVE WASD / ARROWS    CAMERA B    PAUSE ENTER    RESTART R",
        "x": 0.5,
        "y": 0.955,
        "normalized": true,
        "centered": true,
        "color": [92, 225, 255, 215]
      },
      {
        "name": "ui.paused",
        "font": "font.hud",
        "visible_if": {
          "type": "app.paused",
          "equals": true
        },
        "text": "PAUSED",
        "x": 0.5,
        "y": 0.30,
        "normalized": true,
        "centered": true,
        "color": [255, 226, 52, 255]
      }
    ],
    "menus": [
      {
        "name": "ui.pause.menu",
        "menu": "menu.pause",
        "font": "font.hud",
        "x": 0.43,
        "y": 0.44,
        "gap": 0.07,
        "normalized": true,
        "align": "left",
        "color": [220, 236, 255, 245],
        "selected_color": [255, 226, 52, 255],
        "selected_pulse_alpha": true,
        "cursor": {
          "text": ">",
          "offset_x": -0.035,
          "align": "right",
          "color": [255, 82, 190, 255],
          "pulse_alpha": true
        }
      }
    ]
  }
}
