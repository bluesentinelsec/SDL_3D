{
  "schema": "sdl3d.scene.v0",
  "name": "scene.options",
  "updates_game": true,
  "renders_world": true,
  "camera": "camera.maze",
  "entities": [
    "entity.field.base",
    "entity.field.grid_glow",
    "entity.effect.ambient",
    "entity.presentation"
  ],
  "input": {
    "actions": [
      "action.menu.up",
      "action.menu.down",
      "action.menu.back",
      "action.menu.select"
    ]
  },
  "transitions": {
    "enter": "scene_in",
    "exit": "scene_out"
  },
  "menus": [
    {
      "name": "menu.options",
      "up_action": "action.menu.up",
      "down_action": "action.menu.down",
      "back_action": "action.menu.back",
      "select_action": "action.menu.select",
      "move_signal": "signal.ui.menu.move",
      "select_signal": "signal.ui.menu.select",
      "selected": 0,
      "items": [
        {
          "label": "Back",
          "scene": "scene.title"
        }
      ]
    }
  ],
  "ui": {
    "text": [
      {
        "name": "ui.options.title",
        "font": "font.title",
        "text": "OPTIONS",
        "x": 0.5,
        "y": 0.24,
        "normalized": true,
        "centered": true,
        "color": [230, 246, 255, 255]
      },
      {
        "name": "ui.options.note",
        "font": "font.small",
        "text": "NO TUNABLES YET",
        "x": 0.5,
        "y": 0.39,
        "normalized": true,
        "centered": true,
        "color": [92, 225, 255, 220]
      }
    ],
    "menus": [
      {
        "name": "ui.options.menu",
        "menu": "menu.options",
        "font": "font.hud",
        "x": 0.46,
        "y": 0.54,
        "gap": 0.075,
        "normalized": true,
        "align": "left",
        "color": [220, 236, 255, 245],
        "selected_color": [255, 226, 52, 255],
        "cursor": {
          "text": ">",
          "offset_x": -0.035,
          "align": "right",
          "color": [255, 82, 190, 255],
          "pulse_alpha": true
        }
      }
    ]
  }
}
