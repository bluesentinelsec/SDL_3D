        "up": [0.0, 1.0, 0.0],
        "size": 10.6,
        "active": true
      },
      {
        "name": "camera.low",
        "type": "perspective",
        "position": [0.0, -6.6, 5.1],
        "target": [0.0, 0.0, 0.0],
        "up": [0.0, 0.0, 1.0],
        "fovy": 48.0,
